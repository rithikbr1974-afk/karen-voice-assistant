# Karen's keys. SETUP.bat / CHANGE_SETTINGS.bat fill this in as .env for you. Never share .env.
GEMINI_API_KEY=              # aistudio.google.com/apikey (free)
GROQ_API_KEY=                # console.groq.com/keys (free; also cloud speech-to-text)
OPENROUTER_API_KEY=          # optional: openrouter.ai/keys (pay as you go; images, screen agent, power mode)

# Gmail, Calendar, Drive, Docs, Sheets (docs/GETTING_STARTED.md > Google)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
USER_GOOGLE_EMAIL=

# Karen on your phone (PHONE_CHAT.bat)
TELEGRAM_BOT_TOKEN=          # from @BotFather /newbot
WHATSAPP_TOKEN=              # optional, Meta Cloud API (docs/GETTING_STARTED.md)
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
NGROK_DOMAIN=

# Free AI pictures ("draw me a ...")
CF_ACCOUNT_ID=
CF_API_TOKEN=

OWNER_PHONE=                 # optional: your number, for "WhatsApp me" from a second phone
