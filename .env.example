# Karen's secret keys. setup.bat fills this in for you (it writes .env).
# To do it by hand: copy this file to .env and fill in the values. NEVER commit .env or share it.

# --- AI brain (at least one is needed; all three have a free option) ---
GEMINI_API_KEY=               # free: https://aistudio.google.com/apikey
GROQ_API_KEY=                 # free, very fast, also does speech-to-text: https://console.groq.com/keys
OPENROUTER_API_KEY=           # optional fallback (free models, or paid credits): https://openrouter.ai/keys

# --- Gmail, Calendar, Drive (optional, see docs/SETUP.md step 6) ---
GOOGLE_OAUTH_CLIENT_ID=       # Google Cloud > APIs & Services > Credentials > OAuth client (Desktop app)
GOOGLE_OAUTH_CLIENT_SECRET=
USER_GOOGLE_EMAIL=            # your Gmail address

# --- Karen Remote: chat with Karen from your phone (optional, see docs/SETUP.md step 8) ---
TELEGRAM_BOT_TOKEN=           # from @BotFather (/newbot); then: python remote.py --pair telegram
WHATSAPP_TOKEN=               # Meta app > WhatsApp > API setup (permanent System User token)
WHATSAPP_PHONE_ID=            # "Phone number ID" of Karen's WhatsApp number
WHATSAPP_APP_SECRET=          # Meta app > Settings > Basic > App secret (checks webhook signatures)
WHATSAPP_VERIFY_TOKEN=        # any words you choose; type the same in Meta's webhook setup
NGROK_DOMAIN=                 # your free ngrok domain, e.g. something.ngrok-free.app
